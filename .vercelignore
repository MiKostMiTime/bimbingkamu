# BimbingKamu — .vercelignore
# File-file berikut tetap tersimpan di git (source untuk build lokal),
# tapi tidak ikut ter-deploy ke Vercel agar permukaan publik tetap ramping.
# vercel.json (outputDirectory ".") tanpa file ini akan menyajikan
# SEMUA file repo sebagai statis, termasuk source yang tidak dimuat browser.

# ---- Source JS: yang dilayani hanya bundle + runtime PWA ----
# app.bundle.js   = bundle hasil `npm run build`
# pwa.js          = registrasi service worker dari browser
# pwa-cache.js    = diimpor sw.js saat runtime, WAJIB tetap dilayani
js/*.js
!js/app.bundle.js
!js/pwa.js
!js/pwa-cache.js

# ---- Source CSS: yang dimuat browser hanya styles.min.css ----
css/variables.css
css/main.css
css/components.css

# ---- Skrip build (esbuild), tidak dibutuhkan saat runtime ----
scripts/
