+class El {
+  constructor(tag = 'div') {
+    this.tagName = String(tag).toUpperCase();
+    this.children = [];
+    this._className = '';
+    this.textContent = '';
+    this.innerHTML = '';
+    this.value = '';
+    this.dataset = {};
+    this.style = {};
